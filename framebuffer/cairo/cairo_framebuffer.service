[Unit]
Description=Cairo framebuffer RENDERER
After=systemd-modules-load.service systemd-user-sessions.service
ConditionPathExists=/dev/fb0

[Service]
Type=simple

User=framebufferusr
SupplementaryGroups=video

ExecStartPre=+/usr/bin/chvt 7
ExecStart=/opt/cairo/framebuffer/main

Restart=on-failure
RestartSec=2

StandardInput=tty
StandardOutput=journal
StandardError=journal

TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
